# Всё, что не нужно внутри образа. Каталог целиком уходит демону docker при
# каждой сборке, поэтому дешевле исключить, чем передать и не использовать.

.git
.idea

# Локальный бинарник: собран под macOS, внутри linux/arm64 бесполезен.
# Шаблоны здесь, в отличие от .gitignore, считаются от корня контекста, а не
# на любой глубине: go build внутри server/ кладёт бинарник в server/server.
messenger
server/server
*.test
*.out

# go build тесты не компилирует, но без этой строки правка теста меняла бы
# содержимое COPY server/ и пересобирала бинарник.
server/*_test.go

# Ставится и собирается в самом образе.
web/node_modules
web/dist

# Тексты, инфраструктура, окружение — к сборке образа отношения не имеют.
*.md
thesis/
cloudformation/
.env
.env.*
